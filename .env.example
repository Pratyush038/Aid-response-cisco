# --- Database (Neon serverless Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Server ---
# Duo's redirect URI must match the port the server actually listens on.
PORT=5000
# Sign session cookies. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Cisco Duo (Web SDK v4 / Universal Prompt) ---
# From Duo Admin Panel -> Applications -> Protect an Application -> "Web SDK"
DUO_CLIENT_ID=DIXXXXXXXXXXXXXXXXXX
DUO_CLIENT_SECRET=your-40-character-client-secret
DUO_API_HOSTNAME=api-xxxxxxxx.duosecurity.com
# Must EXACTLY match the Redirect URI registered in the Duo Admin Panel
DUO_REDIRECT_URI=http://localhost:5000/api/auth/duo/callback

# --- Integrations ---
VITE_MAPBOX_API_KEY=pk.your-mapbox-public-token
GROQ_API_KEY=gsk_your_groq_key
WEBEX_BOT_TOKEN=your-webex-bot-token
WEBEX_ROOM_ID=your-webex-room-id
